<?xml version="1.0"?>
<!--
  Minimal core-site.xml for the HOST-side Spark driver (Case C). We don't use
  the hdfs:// scheme from the host (see docs/07 for why — WebHDFS via the
  HttpFS gateway is used instead), so this mostly just avoids Hadoop client
  warnings about a missing fs.defaultFS.
-->
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>webhdfs://localhost:14000</value>
  </property>
</configuration>
