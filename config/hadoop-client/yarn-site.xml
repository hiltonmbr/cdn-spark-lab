<?xml version="1.0"?>
<!--
  Minimal YARN client config for the HOST-side Spark driver (Case C).

  This is deliberately separate from config/hadoop/ (auto-generated from
  .env for the containers themselves). Containers resolve the ResourceManager
  as "resourcemanager" over the Docker network; the host driver instead
  resolves it as "localhost" through docker-compose's published ports
  (8088 web UI, 8032 client RPC, 8030 scheduler RPC — see docker-compose.yml).
  Setting yarn.resourcemanager.hostname is enough: Hadoop derives every other
  yarn.resourcemanager.*.address from it at its default port.
-->
<configuration>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>localhost</value>
  </property>
</configuration>
