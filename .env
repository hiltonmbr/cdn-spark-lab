# =============================================================================
# Configuração do Cluster Hadoop — Variáveis de Ambiente (profile "hadoop")
# =============================================================================
# Estas variáveis de ambiente são automaticamente convertidas pela imagem
# apache/hadoop:3.5.0 em arquivos de configuração XML na inicialização do
# container.
#
# Convenção:  FILE.xml_property.name=valor
# Exemplo:    CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
#              -> core-site.xml recebe <property><name>fs.defaultFS</name><value>...</value></property>
#
# Este cluster é um *coadjuvante* para o Spark (diferente do cdn-hadoop-lab,
# onde os internos do HDFS são o foco) — reduzido para 2 DataNodes e 2
# NodeManagers.
# =============================================================================

HADOOP_HOME=/opt/hadoop

# --- core-site.xml ----------------------------------------------------------
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
# As regras de proxy user permitem que o gateway HttpFS impersonate usuários
# em nome do Spark driver, que se comunica com o HDFS exclusivamente via
# WebHDFS (veja docs/07).
CORE-SITE.XML_hadoop.proxyuser.root.hosts=*
CORE-SITE.XML_hadoop.proxyuser.root.groups=*

# --- hdfs-site.xml ----------------------------------------------------------
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
# 2 réplicas: um DataNode pode cair sem perder dados (o laboratório de caos
# 08 mata um NodeManager, não um DataNode, mas isso mantém o HDFS resiliente
# também)
HDFS-SITE.XML_dfs.replication=2
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.hosts.exclude=/opt/hadoop/etc/hadoop/exclude-hosts
# WebHDFS deve estar habilitado no NameNode para o gateway HttpFS fazer proxy
HDFS-SITE.XML_dfs.webhdfs.enabled=true

# --- mapred-site.xml --------------------------------------------------------
MAPRED-SITE.XML_mapreduce.framework.name=yarn
MAPRED-SITE.XML_yarn.app.mapreduce.am.env=HADOOP_MAPRED_HOME=$HADOOP_HOME
MAPRED-SITE.XML_mapreduce.map.env=HADOOP_MAPRED_HOME=$HADOOP_HOME
MAPRED-SITE.XML_mapreduce.reduce.env=HADOOP_MAPRED_HOME=$HADOOP_HOME

# --- yarn-site.xml ------------------------------------------------------------
YARN-SITE.XML_yarn.resourcemanager.hostname=resourcemanager
YARN-SITE.XML_yarn.nodemanager.pmem-check-enabled=false
YARN-SITE.XML_yarn.nodemanager.vmem-check-enabled=false
YARN-SITE.XML_yarn.nodemanager.delete.debug-delay-sec=600
YARN-SITE.XML_yarn.nodemanager.aux-services=mapreduce_shuffle
# Cada NodeManager oferece 2 vcores / 3GB para que 2 NodeManagers possam
# hospedar 2-3 executores Spark concorrentes no total — suficiente para o
# laboratório de caos (08) mostrar falha parcial + reescalonamento de tarefas
# em vez de uma destruição total do cluster.
YARN-SITE.XML_yarn.nodemanager.resource.memory-mb=3072
YARN-SITE.XML_yarn.nodemanager.resource.cpu-vcores=2
YARN-SITE.XML_yarn.scheduler.maximum-allocation-mb=3072
YARN-SITE.XML_yarn.scheduler.maximum-allocation-vcores=2

# --- capacity-scheduler.xml ---------------------------------------------------
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.maximum-applications=10000
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.maximum-am-resource-percent=0.5
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.resource-calculator=org.apache.hadoop.yarn.util.resource.DominantResourceCalculator
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.queues=default
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.capacity=100
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.maximum-capacity=100
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.user-limit-factor=1
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.state=RUNNING
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.acl_submit_applications=*
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.acl_administer_queue=*
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.node-locality-delay=40
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.queue-mappings=
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.queue-mappings-override.enable=false
